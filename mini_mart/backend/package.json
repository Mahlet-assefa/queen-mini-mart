{
  "name": "queen-mart-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env index.mjs",
    "start": "NODE_ENV=production node --env-file-if-exists=.env index.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "db:admin": "node --env-file-if-exists=.env setup-admin.mjs",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
