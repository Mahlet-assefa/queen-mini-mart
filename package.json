{
  "name": "mini-mart-inventory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "dev:web": "next dev mini_mart/frontend",
    "dev:api": "node --env-file-if-exists=.env mini_mart/backend/index.mjs",
    "build": "next build mini_mart/frontend",
    "start": "node scripts/run.mjs start",
    "typecheck": "tsc --noEmit -p mini_mart/frontend/tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:api": "node --test tests/api.integration.mjs",
    "db:migrate": "prisma migrate deploy --schema mini_mart/backend/prisma/schema.prisma",
    "db:seed": "node --experimental-strip-types mini_mart/backend/prisma/seed.ts",
    "db:admin": "node --env-file-if-exists=.env mini_mart/backend/setup-admin.mjs",
    "db:generate": "prisma generate --schema mini_mart/backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0",
    "@prisma/client": "^6.19.3",
    "express": "^5.3.0",
    "lucide-react": "https://registry.npmjs.org/lucide-react/-/lucide-react-0.468.0.tgz",
    "next": "^15.5.28",
    "react": "https://registry.npmjs.org/react/-/react-19.2.8.tgz",
    "react-dom": "https://registry.npmjs.org/react-dom/-/react-dom-19.2.8.tgz"
  },
  "devDependencies": {
    "@types/node": "https://registry.npmjs.org/@types/node/-/node-22.20.1.tgz",
    "@types/react": "https://registry.npmjs.org/@types/react/-/react-19.2.18.tgz",
    "@types/react-dom": "https://registry.npmjs.org/@types/react-dom/-/react-dom-19.2.5.tgz",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "typescript": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz"
  },
  "overrides": {
    "postcss": "8.5.32",
    "deepmerge-ts": "8.0.2"
  }
}
